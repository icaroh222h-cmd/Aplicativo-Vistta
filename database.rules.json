{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() == 'admin')",
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() == 'admin')",
        ".validate": "newData.hasChildren(['role', 'email']) && (newData.child('role').val() == 'admin' || newData.child('role').val() == 'gerente' || newData.child('role').val() == 'vendedor' || newData.child('role').val() == 'caixa' || newData.child('role').val() == 'estoque' || newData.child('role').val() == 'atendente') && newData.child('email').isString()"
      }
    },
    "configuracoes": {
      "empresa": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'"
      }
    },
